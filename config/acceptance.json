{
    "site": "acceptance",
    "use_sections": false,
    "widgets": [
        {
            "id": "quick_quote",
            "match": [
                "Quick Quote Widget",
                "Quote Widget",
                "<Quote Widget>",
                "[Quote widget]",
                "<Quick Quote Widget>"
            ],
            "output": "[quick_quote_widget]",
            "max_occurrences": 1
        },
        {
            "id": "type_of_coverage",
            "match": [
                "Types of Coverage widget",
                "<Types of Coverage Widget>"
            ],
            "output": "[products_access_widget]",
            "max_occurrences": 1
        },
        {
            "id": "get_call_us",
            "match": [
                "Quote Box Widget with Icons",
                "<Quote Box Widget with Icons>",
                "<CTA Box>"
            ],
            "output": "[component_get_call_out]",
            "max_occurrences": 1
        }

    ],
    "special_buttons": [],
    "link_replacements": [
    {
      "from": "https://www.acceptance.com/",
      "to": "https://acceptance.confiedevstg.com/"
    }
  ]
}

